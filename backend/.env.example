RELAYER_MIN_FEE_ETH=200000000000000
RELAYER_MIN_FEE_USDG=500000

# $OBSYN, once launched (the site picks these up without a rebuild)
PLATFORM_TOKEN_ADDRESS=
PLATFORM_TOKEN_PONS_URL=
PLATFORM_TOKEN_DISCOUNT_MIN=
